# Onion — variáveis para Vercel / local
# NUNCA coloque token Discord de usuário aqui.

# URL pública do site (obrigatório em produção com domínio custom)
# Ex: https://onion.vercel.app  ou  https://seu-dominio.com
APP_ORIGIN=

# Origens extras (preview URLs), separadas por vírgula
# ALLOWED_ORIGINS=https://onion-git-main-user.vercel.app

# No Vercel deixe 1 (ou confie no auto-detect VERCEL=1)
TRUST_PROXY=1

# Código de acesso opcional (só é exigido se REQUIRE_ACCESS_CODE=1)
# ONION_ACCESS_CODE=Onion#2026_K9mP!xQ7vL
# REQUIRE_ACCESS_CODE=0

# Limites do job
MAX_DELETE_MESSAGES=2000
MAX_SCAN_PAGES=50
CLEAN_TIMEOUT_MS=240000
MAX_GLOBAL_JOBS=20
MAX_SESSION_JOBS=1

# Delays para reduzir rate limit do Discord (ms)
DELETE_DELAY_MS=1400
FETCH_DELAY_MS=900
